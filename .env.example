# ── Slack ──
# Get from https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_CHANNEL_ID=C0123456789             # The channel ID of #new-clients

# ── HubSpot ──
# Get Private App Token from Settings -> Integrations -> Private Apps
HUBSPOT_TOKEN=pat-na1-your-hubspot-token
HUBSPOT_PIPELINE_ID=default              # Or your custom pipeline ID
HUBSPOT_STAGE_APPOINTMENT_SCHEDULED=appointmentscheduled
HUBSPOT_STAGE_QUALIFIED=qualifiedtobuy
HUBSPOT_STAGE_PRESENTATION=presentationscheduled
HUBSPOT_STAGE_DECISION_MAKER=decisionmakerboughtin
HUBSPOT_STAGE_CONTRACT_SENT=contractsent
HUBSPOT_STAGE_CLOSED_WON=closedwon

# ── SignWell ──
# Get API Key from https://www.signwell.com -> Settings -> API
SIGNWELL_API_KEY=your-signwell-api-key
SIGNWELL_SENDER_NAME=Software Bechi Admin
SIGNWELL_SENDER_TITLE="Managing Director, SOFTWARE BECHI Inc."
SIGNWELL_SENDER_EMAIL=admin@softwarebechi.com

# ── Admin Verification Auth ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=softwarebechi2026
ADMIN_SECRET_TOKEN=sb_sec_token_example

# ── Calendly ──
# Your booking link: e.g. https://calendly.com/your-username/30min
CALENDLY_LINK=https://calendly.com/softwarebechi/kickoff-meeting
CALENDLY_TOKEN=your-calendly-personal-access-token

# ── Stripe (Test Mode) ──
# Get from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_test_secret_key

# ── Email (Nodemailer / Gmail App Password) ──
# If left empty, system prints email contents directly to the console
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_NAME="Software Bechi Team"

# ── Server ──
PORT=3000
